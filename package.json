{
  "name": "clickfix-warden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser extension that stops ClickFix and fake CAPTCHA attacks and warns about sites reported as malicious.",
  "license": "MIT",
  "author": "xVoidByte",
  "homepage": "https://github.com/xVoidByte/ClickFixWarden",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:edge": "wxt build -b edge",
    "build:all": "npm run build && npm run build:firefox && npm run build:edge",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip && wxt zip -b firefox --mv3 && wxt zip -b edge && tsx scripts/hash-build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test",
    "lint:firefox": "web-ext lint -s .output/firefox-mv3 --self-hosted=false",
    "feed:build": "tsx feed-builder/build-feed.ts",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "review:clickfix": "tsx scripts/review-new-clickfix.ts",
    "icons": "tsx scripts/render-icons.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.0",
    "fflate": "^0.8.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
